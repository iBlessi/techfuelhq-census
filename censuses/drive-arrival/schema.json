{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/iBlessi/techfuelhq-census/main/censuses/drive-arrival/schema.json",
  "title": "TechFuelHQ Drive Arrival Census",
  "description": "One row is one drive as it arrived. In the CSV every value is text and an empty cell means the field was left out. Dataset version 0.1.0.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "seller": {
      "title": "Seller",
      "description": "The shop, or the marketplace and the seller's name on it.",
      "type": "string",
      "maxLength": 60,
      "x-source": "human"
    },
    "listing_condition": {
      "title": "Condition on the listing",
      "type": "string",
      "enum": [
        "new",
        "manufacturer-recertified",
        "seller-refurbished",
        "used",
        "open-box"
      ],
      "x-source": "human"
    },
    "purchase_month": {
      "title": "Bought",
      "description": "Year and month, written 2026-08.",
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}$",
      "x-source": "human"
    },
    "drive_vendor": {
      "title": "Drive maker",
      "type": "string",
      "enum": [
        "seagate",
        "wd",
        "hgst",
        "toshiba",
        "other"
      ],
      "x-source": "machine"
    },
    "model_family": {
      "title": "Model family",
      "type": "string",
      "maxLength": 80,
      "x-source": "machine"
    },
    "model": {
      "title": "Model",
      "type": "string",
      "maxLength": 60,
      "x-source": "machine"
    },
    "capacity_tb": {
      "title": "Capacity (TB)",
      "type": "number",
      "minimum": 0.1,
      "maximum": 100,
      "x-source": "machine"
    },
    "interface": {
      "title": "Interface",
      "type": "string",
      "enum": [
        "sata",
        "sas"
      ],
      "x-source": "machine"
    },
    "smartctl_version": {
      "title": "smartctl version",
      "type": "string",
      "maxLength": 20,
      "x-source": "machine"
    },
    "smart_poh": {
      "title": "Power-on hours, SMART",
      "type": "integer",
      "minimum": 0,
      "maximum": 200000,
      "x-source": "machine"
    },
    "smart_power_cycles": {
      "title": "Power cycles, SMART",
      "type": "integer",
      "minimum": 0,
      "maximum": 10000000,
      "x-source": "machine"
    },
    "reallocated": {
      "title": "Reallocated sectors",
      "type": "integer",
      "minimum": 0,
      "maximum": 10000000,
      "x-source": "machine"
    },
    "pending": {
      "title": "Pending sectors",
      "type": "integer",
      "minimum": 0,
      "maximum": 10000000,
      "x-source": "machine"
    },
    "offline_uncorrectable": {
      "title": "Offline uncorrectable",
      "type": "integer",
      "minimum": 0,
      "maximum": 10000000,
      "x-source": "machine"
    },
    "crc_errors": {
      "title": "Interface CRC errors",
      "type": "integer",
      "minimum": 0,
      "maximum": 10000000,
      "x-source": "machine"
    },
    "load_cycles": {
      "title": "Load cycles",
      "type": "integer",
      "minimum": 0,
      "maximum": 100000000,
      "x-source": "machine"
    },
    "farm": {
      "title": "Seagate FARM log",
      "type": "string",
      "enum": [
        "read",
        "not-supported",
        "not-provided"
      ],
      "x-source": "machine"
    },
    "farm_poh": {
      "title": "Power-on hours, FARM",
      "type": "integer",
      "minimum": 0,
      "maximum": 200000,
      "x-source": "machine"
    },
    "farm_spindle_poh": {
      "title": "Spindle power-on hours, FARM",
      "type": "integer",
      "minimum": 0,
      "maximum": 200000,
      "x-source": "machine"
    },
    "farm_head_flight_hours": {
      "title": "Head flight hours, FARM",
      "type": "integer",
      "minimum": 0,
      "maximum": 200000,
      "x-source": "machine"
    },
    "farm_power_cycles": {
      "title": "Power cycles, FARM",
      "type": "integer",
      "minimum": 0,
      "maximum": 10000000,
      "x-source": "machine"
    },
    "farm_assembly_yyww": {
      "title": "Assembly date as FARM prints it",
      "type": "string",
      "pattern": "^[0-9]{4}$",
      "x-source": "machine"
    },
    "poh_gap_h": {
      "title": "FARM hours minus SMART hours",
      "type": "integer",
      "minimum": -200000,
      "maximum": 200000,
      "x-source": "derived"
    },
    "arrived": {
      "title": "How it arrived",
      "type": "string",
      "enum": [
        "working",
        "dead",
        "errors-on-first-test"
      ],
      "x-source": "human"
    },
    "first_test": {
      "title": "Test run before use",
      "type": "string",
      "enum": [
        "none",
        "short-smart",
        "long-smart",
        "full-surface"
      ],
      "x-source": "human"
    },
    "notes": {
      "title": "Notes",
      "type": "string",
      "maxLength": 280,
      "x-source": "human"
    },
    "submitted_date": {
      "title": "The day the report was sent",
      "type": "string",
      "format": "date",
      "x-source": "intake"
    },
    "source_issue": {
      "title": "The issue the row came from",
      "type": "integer",
      "minimum": 1,
      "x-source": "intake"
    }
  },
  "required": [
    "seller",
    "listing_condition",
    "purchase_month",
    "drive_vendor",
    "model",
    "capacity_tb",
    "interface",
    "smart_poh",
    "farm",
    "arrived",
    "first_test",
    "submitted_date"
  ]
}
